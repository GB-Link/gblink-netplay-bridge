<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The RetroArch lobby is reached over plain HTTP, as RetroArch itself does. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">lobby.libretro.com</domain>
    </domain-config>
</network-security-config>
